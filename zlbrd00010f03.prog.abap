*&---------------------------------------------------------------------*
*& Form CREATE_STATUS_BAR
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM create_status_bar USING pv_program_name.
  DATA : lv_mainprogram_name LIKE  trdir-name,
         _program            TYPE  trdir-name.

  lv_mainprogram_name = pv_program_name.

  DATA: ista TYPE TABLE OF rsmpe_stat,
        ifun TYPE TABLE OF rsmpe_funt,
        imen TYPE TABLE OF rsmpe_men,
        imtx TYPE TABLE OF rsmpe_mnlt,
        iact TYPE TABLE OF rsmpe_act,
        ibut TYPE TABLE OF rsmpe_but,
        ipfk TYPE TABLE OF rsmpe_pfk,
        iset TYPE TABLE OF rsmpe_staf,
        idoc TYPE TABLE OF rsmpe_atrt,
        itit TYPE TABLE OF rsmpe_titt,
        ibiv TYPE TABLE OF rsmpe_buts.
  DATA xadm   TYPE rsmpe_adm.
  DATA xtrkey TYPE trkey.
  _program = lv_mainprogram_name.

  xtrkey-obj_type = 'PROG'.
  xtrkey-obj_name = _program.
  xtrkey-sub_type = 'CUAD'.
  xtrkey-sub_name = _program.

*
  xadm-actcode = '000002'.
  xadm-pfkcode = '000006'.

  ista = VALUE #(
  ( code = '0100' modal = 'D' actcode = '000001' pfkcode = '000001' butcode = '0001' int_note = 'Status 100' )
  ( code = '0200' modal = 'P' actcode = '' pfkcode = '000002' butcode = '0001' int_note = 'Status 200' )
  ( code = '0300' modal = 'P' actcode = '' pfkcode = '000003' butcode = '0001' int_note = 'Status 300' )
  ( code = '0400' modal = 'P' actcode = '' pfkcode = '000005' butcode = '0001' int_note = 'Status 400' )
  ( code = '0500' modal = 'P' actcode = '' pfkcode = '000006' butcode = '0001' int_note = 'Status 500' )
   ).

  ifun = VALUE #(
  ( code = 'BACK' textno = '001' type = 'E' text_type = 'S' text_name = 'ICON_SYSTEM_BACK' icon_id = '@2M@' fun_text = 'Back' )
  ( code = 'CANC' textno = '001' type = 'E' text_type = 'S' text_name = 'ICON_SYSTEM_CANCEL' icon_id = '@2O@' fun_text = 'Cancel' )
  ( code = 'EXEC' textno = '001' type = '' text_type = 'S' text_name = 'ICON_CANCEL' icon_id = '@2O@' fun_text = 'Cancel' path = 'A' )
  ( code = 'EXIT' textno = '001' type = 'E' text_type = 'S' text_name = '' icon_id = '' fun_text = 'Exit' )
  ( code = 'GEN_FC' textno = '001' type = '' text_type = 'S' text_name = 'ICON_EXECUTE_OBJECT' icon_id = '@15@' fun_text = 'Generate' )
  ( code = 'SAVE' textno = '001' type = ' ' text_type = 'S' text_name = 'ICON_SYSTEM_SAVE' icon_id = '@2L@' fun_text = 'Save' )
  ).


  ipfk = VALUE #(
( code = '000001' pfno = '03' funcode = 'BACK' funno = '001' )
( code = '000001' pfno = '12' funcode = 'CANC' funno = '001' )
( code = '000001' pfno = '15' funcode = 'EXIT' funno = '001' )
( code = '000002' pfno = '11' funcode = 'SAVE' funno = '001' )
( code = '000002' pfno = '12' funcode = 'CANC' funno = '001' )
( code = '000003' pfno = '08' funcode = 'SAVE' funno = '001' )
( code = '000003' pfno = '12' funcode = 'CANC' funno = '001' )
( code = '000005' pfno = '12' funcode = 'CANC' funno = '001' )
( code = '000006' pfno = '00' funcode = 'SAVE' funno = '001' )
( code = '000006' pfno = '08' funcode = 'GEN_FC' funno = '001' )
( code = '000006' pfno = '12' funcode = 'CANC' funno = '001' )
  ).

  iset = VALUE #(
( status = '0100' function = 'BACK' )
( status = '0100' function = 'CANC' )
( status = '0100' function = 'EXIT' )
( status = '0200' function = 'CANC' )
( status = '0200' function = 'SAVE' )
( status = '0300' function = 'CANC' )
( status = '0300' function = 'SAVE' )
( status = '0400' function = 'CANC' )
( status = '0500' function = 'CANC' )
( status = '0500' function = 'GEN_FC' )
( status = '0500' function = 'SAVE' )
  ).

  idoc = VALUE #(
( obj_type = 'A' obj_code = '000001' sub_code = '' modal = 'D' int_note = 'Status' )
( obj_type = 'P' obj_code = '000001' sub_code = '' modal = 'D' int_note = 'Status' )
( obj_type = 'B' obj_code = '000001' sub_code = '0001' modal = 'D' int_note = 'Status' )
( obj_type = 'P' obj_code = '000002' sub_code = '' modal = 'P' int_note = '200' )
( obj_type = 'B' obj_code = '000002' sub_code = '0001' modal = 'P' int_note = '200' )
( obj_type = 'P' obj_code = '000003' sub_code = '' modal = 'P' int_note = '300' )
( obj_type = 'B' obj_code = '000003' sub_code = '0001' modal = 'P' int_note = '300' )
( obj_type = 'A' obj_code = '000002' sub_code = '' modal = 'D' int_note = '0400' )
( obj_type = 'P' obj_code = '000004' sub_code = '' modal = 'D' int_note = '0400' )
( obj_type = 'B' obj_code = '000004' sub_code = '0001' modal = 'D' int_note = '0400' )
( obj_type = 'P' obj_code = '000005' sub_code = '' modal = 'P' int_note = '0400' )
( obj_type = 'B' obj_code = '000005' sub_code = '0001' modal = 'P' int_note = '0400' )
( obj_type = 'P' obj_code = '000006' sub_code = '' modal = 'P' int_note = 'Status' )
( obj_type = 'B' obj_code = '000006' sub_code = '0001' modal = 'P' int_note = 'Status' )
   ).

  itit = VALUE #(
( code = '0100' text = 'BALV Configuration Management' )
( code = '0200' text = 'Template Catalog' )
( code = '0300' text = 'Copy Catalog' )
( code = '0400' text = 'Color' )
( code = '0500' text = 'Code Fieldcatalog' )
).

  CALL FUNCTION 'RS_CUA_INTERNAL_WRITE'
    EXPORTING
      program   = _program
      language  = sy-langu
      tr_key    = xtrkey
      adm       = xadm
      state     = 'A'
    TABLES
      sta       = ista
      fun       = ifun
      men       = imen
      mtx       = imtx
      act       = iact
      but       = ibut
      pfk       = ipfk
      set       = iset
      doc       = idoc
      tit       = itit
      biv       = ibiv
    EXCEPTIONS
      not_found = 1
      OTHERS    = 2.
ENDFORM.
