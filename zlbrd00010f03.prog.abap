*&---------------------------------------------------------------------*
*& Form CREATE_SCREEN
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM create_screen .
  DATA : lv_program_name     LIKE  trdir-name,
         lv_program_ordernum LIKE  e070-trkorr,
         lv_program_devclass LIKE  tdevc-devclass.

  lv_program_name = sy-repid.

  PERFORM get_cts USING lv_program_name lv_program_devclass lv_program_ordernum.


  PERFORM create_screen_100 USING lv_program_name lv_program_ordernum.
  PERFORM create_screen_200 USING lv_program_name lv_program_ordernum.
  PERFORM create_screen_300 USING lv_program_name lv_program_ordernum.
  PERFORM create_screen_400 USING lv_program_name lv_program_ordernum.
  PERFORM create_screen_500 USING lv_program_name lv_program_ordernum.

  PERFORM create_status_bar USING lv_program_name.
ENDFORM.
*&---------------------------------------------------------------------*
*& Form GET_CTS
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> LV_PROGRAM_NAME
*&---------------------------------------------------------------------*
FORM get_cts  USING    pv_program_name pv_program_devclass pv_program_ordernum.
  DATA : ls_ko200            LIKE  ko200,
         ls_tadir            TYPE tadir,
         lv_program_name     LIKE  trdir-name,
         lv_program_corrnum  LIKE  e070-trkorr,
         lv_program_ordernum LIKE  e070-trkorr,
         lv_program_devclass LIKE  tdevc-devclass.

  lv_program_name = pv_program_name.

  ls_ko200-pgmid = 'R3TR'.
  ls_ko200-object = 'PROG'.
  ls_ko200-obj_name = lv_program_name.
  ls_ko200-masterlang = sy-langu.
  CALL FUNCTION 'CONVERSION_EXIT_ISOLA_OUTPUT'
    EXPORTING
      input  = sy-langu
    IMPORTING
      output = ls_ko200-masterlang.
  ls_ko200-operation = '1'.

  CALL FUNCTION 'TRINT_CORR_INSERT'
    EXPORTING
      is_ko200 = ls_ko200
    IMPORTING
      we_order = lv_program_ordernum "request
      we_task  = lv_program_corrnum "task
      es_tadir = ls_tadir.

  pv_program_ordernum = lv_program_ordernum.
  pv_program_devclass = ls_tadir-devclass. "package name
ENDFORM.
*&---------------------------------------------------------------------*
*& Form CREATE_SCREEN_100
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM create_screen_100 USING pv_program_name pv_program_corrnum.
  CLEAR gs_dynpro.
  gs_dynpro-header-program     = pv_program_name.
  gs_dynpro-header-screen      = '0100'.
  gs_dynpro-header-language    = 'EN'.
  gs_dynpro-header-descript    = 'BALV Configuration Management'.
  gs_dynpro-header-type        = 'N'.
  gs_dynpro-header-nextscreen  = '0100'.
  gs_dynpro-header-lines       = 200.
  gs_dynpro-header-columns     = 255.

  gs_dynpro-flow_logic = VALUE #(
  ( line = `PROCESS BEFORE OUTPUT.` )
  ( line = `  MODULE status_0100.` )
  ( line = `  MODULE set_alv.` )
  ( line = `PROCESS AFTER INPUT.` )
  ( line = `  MODULE exit_command_100 AT EXIT-COMMAND.` )
  ( line = `  MODULE user_command_0100.  ` )
   ).

  "Screen Control
  gs_dynpro-containers = VALUE #(
  ( type = 'SCREEN' name = 'SCREEN' line = '000' column = '000'
    length = '000' height = '000' loop_block = '000' loop_disp = '000'
    c_line_min = '000' c_coln_min = '000' tc_fixcol = '000' ) ).
  "OK Code
  gs_dynpro-fields = VALUE #(
  ( cont_type = 'SCREEN' cont_name = 'SCREEN' type = 'OKCODE' name = 'GV_OKCODE'
    text = '____________________' line = '000' column = '000' length = '020' vislength = '020'
    height = '001' input_fld = 'X' format = 'CHAR'  ) ).

  CALL FUNCTION 'RPY_DYNPRO_INSERT'
    EXPORTING
      header                 = gs_dynpro-header
      suppress_exist_checks  = abap_true
      corrnum                = pv_program_corrnum
    TABLES
      containers             = gs_dynpro-containers
      fields_to_containers   = gs_dynpro-fields
      flow_logic             = gs_dynpro-flow_logic
    EXCEPTIONS
      cancelled              = 1
      already_exists         = 2
      program_not_exists     = 3
      not_executed           = 4
      missing_required_field = 5
      illegal_field_value    = 6
      field_not_allowed      = 7
      not_generated          = 8
      illegal_field_position = 9
      OTHERS                 = 10.
ENDFORM.
